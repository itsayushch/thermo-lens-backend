# ==============================================================================
# ThermoLens Backend Configuration
# ==============================================================================

# Database connection URL for local PostgreSQL with PostGIS extension.
# Note: Each developer will have different credentials/ports depending on local OS setup.
# Example: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thermolens

# NASA FIRMS API Key for satellite hotspot ingestion
# Sign up and generate a key at: https://firms.modaps.eosdis.nasa.gov/api/
# Used by GET /hotspots to fetch real active fire detections. If unset, the API
# falls back to CSV files placed in data/.
FIRMS_API_KEY=your_firms_api_key_here

# API Server Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# Optional Azure Blob source for the roster. In Azure Container Apps, the
# app uses its managed identity; do not set storage keys or connection strings.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_ROSTER_CONTAINER=datasets
AZURE_ROSTER_BLOB=factory_roster_2yr.parquet
